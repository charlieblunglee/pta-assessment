# Public browser configuration (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only configuration. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-server-only-api-key
RESULTS_FROM_EMAIL=HIMAP Assessment <assessment@example.com>

# Optional alternative providers. Change EMAIL_PROVIDER when using one.
POSTMARK_SERVER_TOKEN=your-server-api-token
RESEND_API_KEY=re_your_server_only_key

# Distributed rate-limit provider for production email delivery.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-server-only-token
